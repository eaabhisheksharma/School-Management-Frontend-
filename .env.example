# ==========================================
# SERVER
# ==========================================
PORT=5000
NODE_ENV=development
APP_DOMAIN=yoursaas.com

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=school_management
DB_USER=postgres
DB_PASSWORD=yourpassword

# ==========================================
# JWT AUTHENTICATION
# ==========================================

# Access Token Secret (64 characters recommended)
JWT_SECRET=3f6e2a9c5d8b1f7e4a6c9d2b0e5f3a8c7d1b6e4f9a2c5d8e0b3f6a1c4d7e9

# Access Token Expiry
JWT_EXPIRES_IN=15m

# Refresh Token Secret
REFRESH_TOKEN_SECRET=9c2e5f7a1b3d6e8f0c4a2b7d9e1f5c3a6d8b0e4f2a7c1d5e9f3b6a8c0d2e4

# Refresh Token Expiry
REFRESH_TOKEN_EXPIRES_IN=7d

# ==========================================
# SUPER ADMIN SETUP KEY
# ==========================================

SUPER_ADMIN_SETUP_KEY=CREATE_SUPER_ADMIN_2026

# ==========================================
# REDIS (Optional if used)
# ==========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=info